# Скопируйте этот файл в .env и впишите свои значения.
# ID берутся так: Discord → Настройки → Расширенные → Режим разработчика (вкл),
# затем правый клик по серверу / каналу / роли → «Копировать ID».

# Токен бота (Developer Portal → ваше приложение → Bot → Reset Token)
DISCORD_TOKEN=

# ID сервера «Легион»
GUILD_ID=

# Канал «Регистратум», куда приходят новички
REGISTRATUM_CHANNEL_ID=

# Закрытый канал, куда бот присылает анкеты
FORMS_CHANNEL_ID=

# Роль, которую получает принятый (Легионеры)
MEMBER_ROLE_ID=

# Роль новичка, которую надо снять при принятии (можно оставить пустым)
NEWCOMER_ROLE_ID=

# Кто может принимать/отклонять заявки: ID ролей через запятую
# (например Сенат, Консулы, Легаты, Центурионы). Администраторы могут всегда.
REVIEWER_ROLE_IDS=

# ===== Секретариум (учёт складов) =====
# Канал, где публикуются карточки складов (пусто — модуль складов выключен)
SECRETARIUM_CHANNEL_ID=
# Закрытый канал для карточек офицерских складов (можно пусто — тогда тоже в Секретариум)
OFFICER_WAREHOUSE_CHANNEL_ID=
# «Инвентариум»: закрытый канал для журнала складов и ежедневных резервных копий
# (в копиях есть пароли складов — канал только для доверенных)
AUDIT_CHANNEL_ID=

# «Архивариум»: журнал Консулата (голосования и итоги)
ARCHIVE_CHANNEL_ID=

# Операции: чат Легиона для напоминаний за 30 минут
LEGION_CHAT_CHANNEL_ID=
# Часовой пояс, в котором офицеры вводят время операций (часы от UTC; МСК = 3)
TZ_OFFSET=3

# Должности — для прав на склады по умолчанию (можно оставить пустыми)
PRINCEPS_ROLE_ID=
SENATE_ROLE_ID=
CONSUL_ROLE_ID=
LEGATE_ROLE_ID=
CENTURION_ROLE_ID=
FABRUM_ROLE_ID=

# Роли гостей
ALLY_ROLE_ID=
WARDEN_ROLE_ID=
